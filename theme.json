{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{
					"slug": "carbon",
					"name": "Carbón",
					"color": "#292824"
				},
				{
					"slug": "oliva",
					"name": "Oliva",
					"color": "#626545"
				},
				{
					"slug": "oliva-claro",
					"name": "Oliva claro",
					"color": "#74784E"
				},
				{
					"slug": "crema",
					"name": "Crema",
					"color": "#F5F2ED"
				},
				{
					"slug": "arena",
					"name": "Arena",
					"color": "#E2DFD3"
				},
				{
					"slug": "blanco",
					"name": "Blanco",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "DM Sans",
					"fontFamily": "'DM Sans Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "display",
					"name": "DM Sans (títulos)",
					"fontFamily": "'DM Sans Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Georgia (cursiva de títulos)",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#F5F2ED",
			"text": "#292824"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "#292824"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)"
				}
			},
			"link": {
				"color": {
					"text": "#626545"
				}
			}
		}
	}
}
