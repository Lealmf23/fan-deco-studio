{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fandeco/banner-carousel",
  "title": "Fan Deco: Pila de banners",
  "category": "fandeco",
  "icon": "images-alt2",
  "description": "Pila de capas: la foto activa al frente y las demás apiladas detrás como capas de una impresión 3D. Flechas, puntos, pausa, deslizamiento táctil y teclado.",
  "textdomain": "fan-deco-studio",
  "attributes": {
    "slides": {
      "type": "array",
      "default": []
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "interval": {
      "type": "integer",
      "default": 5
    },
    "animate": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "render": "file:./render.php"
}