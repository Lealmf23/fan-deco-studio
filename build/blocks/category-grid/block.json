{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fandeco/category-grid",
  "title": "Fan Deco: Grilla de categorías",
  "category": "fandeco",
  "icon": "grid-view",
  "description": "Categorías de WooCommerce con su imagen, título, descripción opcional y enlace.",
  "textdomain": "fan-deco-studio",
  "attributes": {
    "categoryIds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": []
    },
    "columns": {
      "type": "integer",
      "enum": [
        2,
        3,
        4
      ],
      "default": 4
    },
    "showDescription": {
      "type": "boolean",
      "default": false
    },
    "showCount": {
      "type": "boolean",
      "default": false
    },
    "animate": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ]
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}