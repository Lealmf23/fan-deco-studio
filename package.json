{
  "name": "fan-deco-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Tema WordPress + WooCommerce para Fan Deco",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build:front": "vite build",
    "build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks",
    "build": "npm run build:front && npm run build:blocks",
    "dev:blocks": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks",
    "lint:php": "node scripts/lint-php.mjs",
    "test": "node scripts/smoke-test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "bump": "node scripts/version.mjs",
    "seo:snapshot": "node scripts/seo-snapshot.mjs",
    "seo:diff": "node scripts/seo-diff.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@wordpress/scripts": "^30.0.0",
    "adm-zip": "^0.5.16",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
